{
  "name": "functions",
  "private": true,
  "version": "0.1.0",
  "description": "Raahi Backend Cloud Functions & Core Domain Engine",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase-admin": "^12.4.0",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "firebase-functions-test": "^3.2.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
