rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Hospital Capability & Live Status - Public Read, Server Write Only
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if false;

      // Resource Holds subcollection - Read for UI state, Server Write Only
      match /holds/{requestId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Emergency Cases - Read for Dispatcher/Hospital, Server Write Only
    match /cases/{caseId} {
      allow read: if true;
      allow write: if false;
    }

    // Routing Requests - Read for Dispatcher/Hospital, Server Write Only
    match /requests/{requestId} {
      allow read: if true;
      allow write: if false;
    }

    // Forensic Audit Trail - Append-only enforcement, Server Created Only
    match /audit_logs/{auditId} {
      allow read: if true;
      allow write: if false; // Only backend Admin SDK can append audit logs
    }

    // Hospital Reliability Aggregates - Public Read, Server Write Only
    match /hospital_reliability/{hospitalId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

