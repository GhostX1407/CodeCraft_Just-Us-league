# ==============================================================================
# Raahi - Capability-Match Ambulance-Hospital Coordination System
# Environment Variable Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit real credentials, tokens, or private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & Firebase Project Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=rahi-healthtech-demo
FIREBASE_STORAGE_BUCKET=rahi-healthtech-demo.appspot.com

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite / React Web SDK)
# Note: Variables prefixed with VITE_ are exposed to the client bundle.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=rahi-healthtech-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rahi-healthtech-demo
VITE_FIREBASE_STORAGE_BUCKET=rahi-healthtech-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Local Development & Emulators
PORT=5001
VITE_API_BASE_URL=http://localhost:5001/rahi-healthtech/us-central1/api
VITE_USE_FIREBASE_EMULATOR=false

# ------------------------------------------------------------------------------
# AI Provider Configuration (Informational Analysis Layer Only)
# Note: AI MUST NEVER participate in safety-critical routing, scoring, holds,
# commitments, timeouts, rerouting, or reliability calculations.
# Backend-only credentials — NEVER expose to frontend or commit real keys.
# ------------------------------------------------------------------------------
# Primary AI Provider: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback AI Provider: Gemini (Invoked only if Groq fails or is unconfigured)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

